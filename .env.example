# Copy to .env.local for local development. Real values live only in Vercel project settings.

# Canonical origin. Local development uses localhost; production sets https://thissidemahesh.in in Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Creator door feature flag. Anything other than "true" keeps the door locked and /creator a 404.
CREATOR_OPEN=false

# Contact form (Resend). Server-only, never prefixed with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
